{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jlcbk/ai-wallet-firewall/blob/main/protocol/policy.schema.json",
  "title": "ESP32 hard signing policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "policy_id", "chain_ids", "limits"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "policy_version": { "type": "integer", "minimum": 1 },
    "policy_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{1,64}$" },
    "chain_ids": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_value_wei_per_tx", "max_value_wei_per_day"],
      "properties": {
        "max_value_wei_per_tx": { "type": "string", "pattern": "^[0-9]+$" },
        "max_value_wei_per_day": { "type": "string", "pattern": "^[0-9]+$" },
        "max_gas_limit": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "allowed_contracts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
      "uniqueItems": true
    },
    "allowed_method_selectors": {
      "type": "array",
      "items": { "type": "string", "pattern": "^0x[a-fA-F0-9]{8}$" },
      "uniqueItems": true
    },
    "blocked_method_selectors": {
      "type": "array",
      "items": { "type": "string", "pattern": "^0x[a-fA-F0-9]{8}$" },
      "uniqueItems": true
    },
    "physical_approval_required_for": {
      "type": "array",
      "items": { "type": "string", "enum": ["unknown_contract", "nft_mint", "token_approval", "value_above_soft_limit"] },
      "uniqueItems": true
    },
    "admin_key_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{1,64}$" }
  }
}
