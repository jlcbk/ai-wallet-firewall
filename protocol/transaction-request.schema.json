{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jlcbk/ai-wallet-firewall/blob/main/protocol/transaction-request.schema.json",
  "title": "Complete unsigned transaction request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "chain_id", "transaction_type", "nonce", "to", "value", "data", "gas_limit", "max_fee_per_gas", "max_priority_fee_per_gas"],
  "properties": {
    "request_version": { "type": "integer", "const": 1 },
    "chain_id": { "type": "integer", "minimum": 1 },
    "transaction_type": { "type": "string", "enum": ["eip1559"] },
    "nonce": { "type": "string", "pattern": "^[0-9]+$" },
    "to": { "type": ["string", "null"], "pattern": "^0x[a-fA-F0-9]{40}$" },
    "value": { "type": "string", "pattern": "^[0-9]+$" },
    "data": { "type": "string", "pattern": "^0x([a-fA-F0-9]{2})*$" },
    "gas_limit": { "type": "string", "pattern": "^[0-9]+$" },
    "max_fee_per_gas": { "type": "string", "pattern": "^[0-9]+$" },
    "max_priority_fee_per_gas": { "type": "string", "pattern": "^[0-9]+$" },
    "access_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "storage_keys"],
        "properties": {
          "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "storage_keys": {
            "type": "array",
            "items": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
            "uniqueItems": true
          }
        }
      }
    },
    "request_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{1,96}$" }
  }
}
