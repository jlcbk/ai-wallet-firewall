{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jlcbk/ai-wallet-firewall/blob/main/protocol/transaction-request.schema.json",
  "title": "完整 unsigned transaction 请求",
  "description": "交给 ESP32 重新解析和授权的完整交易请求。该模型不接受主机预先计算的 signing hash。",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "chain_id", "transaction_type", "nonce", "to", "value", "data", "gas_limit", "max_fee_per_gas", "max_priority_fee_per_gas"],
  "properties": {
    "request_version": { "type": "integer", "const": 1, "description": "交易请求协议版本。" },
    "chain_id": { "type": "integer", "minimum": 1, "description": "交易要发送到的链 ID，必须由 ESP32 独立检查。" },
    "transaction_type": { "type": "string", "enum": ["eip1559"], "description": "已实现并可被设备解析的交易类型。" },
    "nonce": { "type": "string", "pattern": "^[0-9]+$", "description": "账户 nonce，使用十进制字符串避免浮点或宽度问题。" },
    "to": { "type": ["string", "null"], "pattern": "^0x[a-fA-F0-9]{40}$", "description": "目标地址；合约创建交易可以为空。" },
    "value": { "type": "string", "pattern": "^[0-9]+$", "description": "转移金额，使用十进制 wei 字符串。" },
    "data": { "type": "string", "pattern": "^0x([a-fA-F0-9]{2})*$", "description": "完整 calldata，必须由 ESP32 自己解析。" },
    "gas_limit": { "type": "string", "pattern": "^[0-9]+$", "description": "交易 gas limit。" },
    "max_fee_per_gas": { "type": "string", "pattern": "^[0-9]+$", "description": "EIP-1559 最大 gas 单价。" },
    "max_priority_fee_per_gas": { "type": "string", "pattern": "^[0-9]+$", "description": "EIP-1559 优先费单价。" },
    "access_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "storage_keys"],
        "properties": {
          "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "storage_keys": {
            "type": "array",
            "items": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
            "uniqueItems": true
          }
        }
      }
    },
    "request_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{1,96}$" }
  }
}
